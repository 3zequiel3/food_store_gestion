# API Configuration
# En producción (Vercel), usar la URL real del backend incluyendo /api/v1.
# Ejemplo: VITE_API_BASE_URL=https://tu-backend.com/api/v1
# En dev local con proxy de Vite puede quedar en /api/v1.
VITE_API_BASE_URL=/api/v1

# Optional image base for relative image paths/storage keys.
# Usually leave empty: absolute S3/proxy URLs from the backend work as-is.
# If the backend returns /uploads/... in production, this should be the backend origin.
# Example: VITE_IMAGE_BASE_URL=https://foodstoregestion-production.up.railway.app
# If using an external public bucket proxy/CDN, point it there instead.
# VITE_IMAGE_BASE_URL=

# MercadoPago Configuration (for future payment integration)
VITE_MP_PUBLIC_KEY=TEST-your-mercadopago-public-key

# Environment
# NODE_ENV is set automatically by Vite: 'development' or 'production'

VITE_WS_URL=ws://localhost:8000