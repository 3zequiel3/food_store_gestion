{
  "$schema": "https://raw.githubusercontent.com/railwayapp/railway/main/schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "restartPolicyMaxRetries": 5,
    "env": {
      "PYTHONPATH": "/app"
    }
  }
}
