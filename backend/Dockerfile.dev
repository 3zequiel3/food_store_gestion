# Backend dev image — FastAPI + uvicorn --reload
# El código se monta como bind volume desde docker-compose; este Dockerfile
# solo prepara el entorno Python con las dependencias.

FROM python:3.12-slim

# Deps de sistema mínimas: curl para healthcheck, libpq para psycopg2 (binary wheel
# generalmente alcanza, pero libpq5 garantiza que no falle el import en runtime).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cacheamos la capa de pip install copiando solo requirements.txt
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# El código se monta como volumen en runtime — NO se copia acá.
# Estructura esperada en runtime: /app/backend/<modules>

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# --reload-dir limita el watch a backend/ para evitar reloads espurios por mounts
# de otras carpetas del host.
CMD ["uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/backend"]
