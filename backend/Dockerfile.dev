# Backend dev image — FastAPI + uvicorn --reload
# El código se monta como bind volume desde docker-compose; este Dockerfile
# solo prepara el entorno Python con las dependencias.
#
# Layout en runtime (root directory = backend/ a la Railway):
#   /app/main.py
#   /app/config.py
#   /app/features/...
#   /app/shared/...
# Los imports en el código son `from config import ...`, `from features.X import ...`.

FROM python:3.12-slim

# Deps de sistema mínimas: curl para healthcheck, libpq para psycopg2 (binary wheel
# generalmente alcanza, pero libpq5 garantiza que no falle el import en runtime).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cacheamos la capa de pip install copiando solo requirements.txt.
# El contexto del build es la raíz del repo, así que el path tiene el prefix backend/.
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# El código se monta como volumen en runtime (./backend:/app) — NO se copia acá.

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# Watch /app entero (que es backend/ del host) para que --reload detecte cambios.
CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app"]
