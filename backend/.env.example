# Database
DATABASE_URL=postgresql://food_user:food_password@localhost:5433/food_store

# Security
JWT_SECRET=change-me-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server / CORS
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# Auth cookies
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Storage: local | s3
STORAGE=local
# STORAGE_LOCAL_DIR=/absolute/path/to/backend/uploads
# Base pública del backend para construir URLs de /uploads o del proxy S3
STORAGE_PUBLIC_BASE_URL=http://localhost:8000
STORAGE_MAX_UPLOAD_MB=5

# Railway S3-compatible storage (solo cuando STORAGE=s3)
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Opcional: usar solo si desplegás un proxy/CDN público para el bucket.
# Railway buckets son privados; sin esto, el backend sirve las imágenes desde
# /api/v1/productos/imagenes/... para evitar 403 del bucket.
# S3_PUBLIC_BASE_URL=https://tu-proxy-publico.example.com/your-bucket-name

# MercadoPago
MP_ACCESS_TOKEN=TEST-tu-access-token-de-mercadopago
MP_PUBLIC_KEY=TEST-tu-public-key-de-mercadopago
