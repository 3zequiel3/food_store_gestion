{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "postgres": {
      "type": "stdio",
      "command": "dbhub",
      "args": ["--transport", "stdio"],
      "env": {
        "POSTGRES_URL": "${POSTGRES_URL:-postgresql://food_user:food_password@localhost:5433/food_store}"
      }
    },
    "railway": {
      "type": "remote",
      "url": "https://mcp.railway.com"
    }
  }
}